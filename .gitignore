# ==========================================
# 1. SENSITIVE CREDENTIALS & ENVIRONMENT (CRITICAL)
# ==========================================
.env
.env.backup
.env.production
.env.local
.env.*.local
/auth.json

# ==========================================
# 2. DEPENDENCIES / PACKAGES
# ==========================================
/vendor
/node_modules

# ==========================================
# 3. LARAVEL STORAGE & TEMPORARY FILES
# ==========================================
/storage/*.key
/storage/pail
/storage/app/*
!/storage/app/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
*.log

# ==========================================
# 4. FRONTEND BUILD ASSETS & CACHE (VITE/TAILWIND)
# ==========================================
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 5. IDE, EDITORS, & AI TOOLS
# ==========================================
/.idea
/.vscode
/.cursor/
/.zed
/.codex
/.nova
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.php_cs.cache
.php-cs-fixer.cache

# ==========================================
# 6. OPERATING SYSTEM & ENVIRONMENT FILES
# ==========================================
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml

# ==========================================
# 7. TESTING & BOOTSTRAP CACHE
# ==========================================
.phpunit.result.cache
/.phpunit.cache
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore